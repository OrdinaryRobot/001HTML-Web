# 构建产物（不需要提交）
public/
resources/_gen/
.hugo_build.lock

# 旧站文件的暂存目录（由 scripts/copy_legacy.sh 或 CI 从仓库根自动生成，
# 源文件就在仓库根，这里不需要重复提交）
static/legacy/

# Hugo 缓存
.hugo_build.lock
/tmp/

# Hugo 处理 JS 时自动生成的 IDE 辅助文件（内容是路径映射，会随主题变化而过时）
assets/jsconfig.json

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 环境变量与密钥（切勿提交）
.env
.env.*
*.pem
*.key
credentials.json

# Node（若后续引入）
node_modules/
npm-debug.log*
yarn-error.log*

# 旧站图片若放根目录，可按需放行；默认不忽略
# !*.html

# 本地推送辅助脚本（含个人操作习惯，不入库）
push.bat

# 本地改动前的原文件留档（不入库）
.backup/
